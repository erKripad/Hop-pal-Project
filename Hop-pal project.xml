clock x;                // local clock of Frog
clock game_clock;             

typedef int[1, 3] Lives;
Lives lives = 3;

void loose_life(){
    lives--;
}

void respawn(){
    frog_x = 9;
    frog_y = 0;
}

void move_frog(){
    frog_y++;
}</declaration>
