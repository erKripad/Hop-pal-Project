		<declaration>// Template Log
clock x;                    // local clock of Log
int shift = 0;
    
bool isFrogOn(){
    int x_norm = (frog_x - shift) % (GRID_W+2);
    return log_x[x_norm] == 1;
}

void moveLog(){
    shift++;
    shift = shift % (GRID_W+2);
}
