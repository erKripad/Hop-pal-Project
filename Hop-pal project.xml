	<template>
		<name>VehicleLane</name>
		<parameter>int speed, int[0, 1]&amp; vehicle_x[GRID_W+2], int n, int[0, GRID_H-1] lane</parameter>
		<declaration>// Template Vehicle
clock x;                    // local clock of Vehicle     
int shift = 0;

void moveVehicle(){
    if(lane%2==0){
        shift++;
    } else {
        shift--;
    }
    shift = ((shift % (GRID_W+2)) + (GRID_W+2)) % (GRID_W+2);
}

bool checkKilled() {
    int x_norm = ((frog_x - shift) % (GRID_W+2) + (GRID_W+2)) % (GRID_W+2);
    return vehicle_x[x_norm] == 1;
}</declaration>
